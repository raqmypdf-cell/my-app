{
  "appId": "com.yourname.app",
  "appName": "بوابة الفكر",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://fikr.edu.sa/main/fikr-portals/?lang=ar",
    "cleansPaths": false,
    "allowNavigation": [
      "fikr.edu.sa",
      "*.fikr.edu.sa",
      "127.0.0.1",
      "localhost"
    ]
  },
  "trustedOrigins": [
    "https://fikr.edu.sa",
    "https://*.fikr.edu.sa",
    "http://127.0.0.1:*",
    "http://localhost:*"
  ],
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0
    }
  }
}
